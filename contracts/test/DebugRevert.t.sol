pragma solidity ^0.8.20;

import "forge-std/Test.sol";

contract DebugRevertTest is Test {
    address constant ZAPPER = 0xdD22aB4b05AF375723Ff9f7C91d19D3Da6bE30F5;
    address constant USER = 0x85F52C53478CD87f571cE18a4a6e43AeBB5DA9D3;

    function test_ReproduceRevert() public {
        vm.createSelectFork("https://rpc.mantle.xyz");
        vm.deal(USER, 100 ether);

        bytes memory payload = hex"";

        vm.prank(USER);
        (bool success, ) = ZAPPER.call{value: 3 ether}(payload);
        require(success, "Reverted");
    }
}
